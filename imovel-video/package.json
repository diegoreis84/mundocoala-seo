    "@remotion/renderer": "^4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
